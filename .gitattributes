# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.cpp text diff=cpp
*.hpp text diff=cpp
*.h text diff=cpp
*.c text diff=cpp
*.cxx text diff=cpp
*.cu text diff=cpp
*.cuh text diff=cpp
*.cmake text
*.py text diff=python
*.sh text eol=lf
*.yml text
*.yaml text
*.json text
*.md text diff=markdown
*.txt text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary

# Build artifacts (linguist overrides)
CMakeLists.txt text
Dockerfile text
